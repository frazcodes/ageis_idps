# ---------------------------------------------------------------------------
# Aegis IDPS - environment template
#
# Copy to `.env` for local development:   cp .env.example .env
# Never commit a real `.env`. Never hardcode credentials in source.
#
# Variable naming convention:  AEGIS_<COMPONENT>_<SETTING>
# ---------------------------------------------------------------------------

# --- Global ---------------------------------------------------------------
AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO
# Emit structured JSON logs (recommended in production / SIEM shipping).
AEGIS_LOG_JSON=false

# --- Central backend ------------------------------------------------------
AEGIS_BACKEND_HOST=127.0.0.1
AEGIS_BACKEND_PORT=8000
# Browser origins allowed to call the API. Empty by default: the administrator
# console is a native desktop app, so no browser origin is required.
AEGIS_BACKEND_CORS_ORIGINS=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_BACKEND_API_KEY=change-me-dev-only

# --- PostgreSQL -----------------------------------------------------------
AEGIS_DB_HOST=127.0.0.1
AEGIS_DB_PORT=5432
AEGIS_DB_NAME=aegis
AEGIS_DB_USER=aegis
AEGIS_DB_PASSWORD=change-me-dev-only
AEGIS_DB_ECHO=false

# --- Endpoint agent -------------------------------------------------------
AEGIS_AGENT_BACKEND_URL=http://127.0.0.1:8000
AEGIS_AGENT_ID=
# Optional. Empty = platform default app-state directory for the persisted host id.
AEGIS_AGENT_STATE_DIR=
AEGIS_AGENT_HEARTBEAT_INTERVAL=30
# Collection is opt-in per monitor; nothing runs until explicitly enabled.
AEGIS_AGENT_ENABLE_PROCESS_MONITOR=false
AEGIS_AGENT_ENABLE_PORT_MONITOR=false
AEGIS_AGENT_ENABLE_CONNECTION_MONITOR=false
AEGIS_AGENT_ENABLE_FILE_INTEGRITY=false
AEGIS_AGENT_ENABLE_YARA=false

# File integrity monitoring only ever inspects the paths listed here; there is no
# implicit filesystem scanning. Comma-separated. Empty = nothing monitored.
AEGIS_AGENT_FILE_INTEGRITY_PATHS=
AEGIS_AGENT_FILE_INTEGRITY_INTERVAL=300
# Files larger than this are not hashed (bytes). 0 disables hashing entirely.
AEGIS_AGENT_FILE_INTEGRITY_MAX_HASH_BYTES=10485760
# skip | report | follow  (skip is the safe default; follow can escape the tree)
AEGIS_AGENT_FILE_INTEGRITY_SYMLINK_POLICY=skip

# In-memory host event pipeline: bounded buffer capacity (FIFO, oldest dropped).
AEGIS_AGENT_EVENT_BUFFER_MAX_EVENTS=1000

# --- Network sensor -------------------------------------------------------
AEGIS_SENSOR_ID=
AEGIS_SENSOR_INTERFACE=
AEGIS_SENSOR_PROMISCUOUS=false
AEGIS_SENSOR_FLOW_WINDOW_SECONDS=10
# Packet capture requires elevated privileges - disabled until explicitly enabled.
AEGIS_SENSOR_CAPTURE_ENABLED=false
# Optional BPF filter (empty = all packets) and processing bounds.
AEGIS_SENSOR_CAPTURE_FILTER=
AEGIS_SENSOR_MAX_PACKETS_PER_RUN=1000
AEGIS_SENSOR_MAX_PACKET_BYTES=65535
# Local addresses used to derive flow direction; empty = direction stays "unknown".
AEGIS_SENSOR_LOCAL_ADDRESSES=

# --- Detection (deterministic rules) --------------------------------------
# Unusually-high network flow volume (rule AEGIS-NET-002). 0 = not configured,
# so the rule never matches until an explicit threshold is supplied. These are
# volume thresholds, not proof of an attack.
AEGIS_DETECTION_NETWORK_VOLUME_PACKET_THRESHOLD=0
AEGIS_DETECTION_NETWORK_VOLUME_BYTE_THRESHOLD=0

# --- ML engine ------------------------------------------------------------
AEGIS_ML_MODEL_DIR=ml-engine/aegis_ml_engine/artifacts
AEGIS_ML_CONTAMINATION=0.05
AEGIS_ML_RISK_THRESHOLD=0.7

# --- Response / IPS engine ------------------------------------------------
# "monitor"  = observe and record decisions only (default, safe)
# "enforce"  = allow policy-approved actions to be executed
AEGIS_RESPONSE_MODE=monitor
AEGIS_RESPONSE_DRY_RUN=true
AEGIS_RESPONSE_REQUIRE_APPROVAL=true
